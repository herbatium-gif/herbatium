# Copiază acest fișier în .env și completează valorile reale. NU urca .env pe git.

# ===== Rulare cu Docker (recomandat — vezi "docker compose up -d --build") =====
# Aceste 3 valori configurează automat baza de date Postgres pornită de
# Docker Compose — nu trebuie completat DATABASE_URL manual în acest caz,
# docker-compose.yml îl construiește singur din ele. Poți lăsa valorile
# implicite de mai jos sau le poți schimba (mai ales parola, dacă expui
# vreodată portul bazei de date în afara calculatorului tău).
POSTGRES_USER="herbatium"
POSTGRES_PASSWORD="schimba-aceasta-parola"
POSTGRES_DB="herbatium"
# Portul de pe calculatorul tău pe care va răspunde aplicația (http://localhost:PORT)
APP_PORT=3000

# ===== Baza de date PostgreSQL, DOAR dacă NU folosești Docker Compose =====
# (rulare directă cu "npm run dev" + o bază de date externă — Railway, Render,
# Supabase, Neon). Cu Docker Compose, ignoră acest câmp.
DATABASE_URL="postgresql://user:parola@localhost:5432/formulator?schema=public"

# Secret pentru semnarea token-urilor de autentificare — orice șir lung, aleator
JWT_SECRET="schimba-asta-cu-un-sir-aleator-lung-si-secret"

# ===== Cont de administrator al aplicației =====
# La fiecare pornire, aplicația creează/actualizează automat un cont cu acces
# TOTAL (fără să depindă de abonament Stripe) și acces la panoul de
# administrare (/admin.html), din valorile de mai jos. Dacă schimbi parola
# aici și repornești aplicația, parola contului se actualizează automat.
# ATENȚIE: nu folosi aici emailul unui client existent — orice cont cu acest
# email devine automat administrator și primește această parolă.
# Lasă ambele goale ca să dezactivezi complet crearea contului de administrator.
ADMIN_EMAIL="herbatium@gmail.com"
ADMIN_PASSWORD="schimba-aceasta-parola-cu-una-lunga-si-sigura"

# Stripe — din Dashboard > Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
# Stripe > Product catalog — creează un produs "Abonament Herbatium" cu un preț recurent LUNAR, apoi copiază id-ul prețului (price_...)
STRIPE_PRICE_ID="price_..."
# Stripe > Developers > Webhooks — după ce adaugi endpoint-ul /api/billing/webhook, copiază "Signing secret"
STRIPE_WEBHOOK_SECRET="whsec_..."

# Adresa publică a aplicației (folosită pentru redirect după plată)
APP_URL="http://localhost:3000"

# Opțional — notificări email (digest zilnic: loturi care expiră curând + stoc
# sub prag minim). Fără RESEND_API_KEY, aplicația funcționează normal, doar
# fără aceste emailuri. Cont gratuit pe https://resend.com.
RESEND_API_KEY=""
NOTIFY_FROM_EMAIL="Herbatium <notificari@resend.dev>"

# Opțional — unde primești TU notificarea de "plată declarată" (transfer
# bancar), cu datele clientului și codul de verificare, ca să știi să intri
# în panoul de admin și să activezi contul. Dacă lipsește, se folosește
# automat ADMIN_EMAIL de mai sus — de regulă nu trebuie să adaugi nimic aici.
# Necesită RESEND_API_KEY setat mai sus, altfel emailul nu se trimite.
ADMIN_NOTIFY_EMAIL=""

PORT=3000
NODE_ENV="development"

# ===== Date firmă, pentru paginile legale (/legal/...) și registrul GDPR =====
# Completează-le cu datele tale reale (PFA/SRL) înainte de lansare — apar
# automat pe paginile de Termeni, Confidențialitate, Cookie-uri, DPA.
COMPANY_NAME="[completează: denumirea firmei/PFA]"
COMPANY_CUI="[completează: CUI/CIF]"
COMPANY_REG="[completează: nr. Registrul Comerțului, dacă e SRL]"
COMPANY_ADDRESS="[completează: adresa sediului]"
COMPANY_EMAIL="contact@exemplu.ro"
# Adresă dedicată cererilor privind protecția datelor (poate fi identică cu cea de mai sus)
COMPANY_GDPR_EMAIL="gdpr@exemplu.ro"
COMPANY_PHONE="[completează: telefon de contact]"
# Se schimbă manual când modifici substanțial textele legale — apare pe pagini
# ca ancoră ("Versiunea X"), ca utilizatorii vechi să vadă că s-au schimbat termenii.
LEGAL_VERSION="1.0"
