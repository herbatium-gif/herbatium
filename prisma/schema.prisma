// Schema bază de date — PostgreSQL
// Rulează: npx prisma migrate dev --name init   (după ce ai completat DATABASE_URL în .env)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  passwordHash String
  createdAt DateTime @default(now())

  // CUI (cod unic de înregistrare) al firmei/PFA a clientului — obligatoriu
  // la înregistrare. Normalizat (fără "RO", fără spații, doar cifre) și unic:
  // o firmă/PFA nu poate deschide un al doilea cont. Scop dublu: (1) necesar
  // pentru facturarea corectă a clientului (e-Factura), (2) previne
  // deschiderea de conturi noi doar ca să se reia promoția introductivă —
  // vezi restricția "first_time_transaction" din billing.js, care altfel
  // acționează doar per client Stripe, nu per firmă reală.
  cui       String?  @unique

  // GDPR — consimțământ la înregistrare (art. 6, 7 GDPR)
  termsVersion      String?   // versiunea Termenilor acceptată (vezi LEGAL_VERSION din .env)
  termsAcceptedAt   DateTime? // data/ora acceptării — dovadă de consimțământ
  marketingConsent  Boolean   @default(false) // bifă separată, nebifată implicit (art. 7 alin. (4))

  // Stripe
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("none") // none | active | past_due | canceled
  currentPeriodEnd     DateTime?

  // Cod de plată — generat o singură dată per client (ex: "HRB-K7F2QX"),
  // stabil pe toată durata contului. Folosit ca referință UNICĂ la orice
  // metodă de plată (transfer bancar acum; Stripe/Netopia pe viitor, prin
  // metadata/descrierea comenzii) — ca să identifici fără ambiguitate cine a
  // plătit, indiferent ce nume/email scrie clientul efectiv pe transfer.
  // Vezi src/routes/billing.js (ensurePaymentCode) și panoul de admin.
  paymentCode String? @unique

  // "Declarația" de plată prin transfer bancar: clientul alege pe pagina de
  // abonament pentru câte luni vrea să plătească, iar aplicația reține aici
  // ce a declarat (fără să confirme că a plătit efectiv — asta o faci TU,
  // manual, în panoul de admin, după ce vezi banii în extrasul de cont).
  // Se resetează (null) după ce activezi manual abonamentul pe baza acestei
  // declarații, ca să nu rămână "agățată" pentru reînnoirea următoare.
  declaredMonths    Int?
  declaredAmountRon Int?
  declaredAt        DateTime?

  // Marchează dacă acest cont a avut VREODATĂ un abonament activ — prin
  // Stripe SAU prin activare manuală (transfer bancar) — indiferent dacă
  // între timp a fost suspendat/anulat și a reluat. Se setează pe true o
  // singură dată, la prima activare reușită, și NU se mai resetează
  // niciodată. Folosit ca să decidem cine mai e "client nou" (are dreptul la
  // prima lună la 99 lei — vezi computeBankTransferAmount în billing.js) și
  // cine nu (a mai plătit cel puțin o dată).
  hasEverSubscribed Boolean @default(false)

  // Retenție date (art. 5 alin. (1) lit. e) GDPR — limitarea stocării): data
  // la care abonamentul a fost anulat (webhook Stripe customer.subscription.deleted).
  // Un job zilnic (src/retention.js) șterge definitiv contul dacă rămâne
  // "canceled" mai mult de RETENTION_DAYS (30 de zile) de la această dată,
  // fără reabonare între timp. Se resetează la null la orice reabonare.
  canceledAt DateTime?

  // Noutăți aplicație — ultima versiune din CHANGELOG (src/changelog.js) pe
  // care utilizatorul a văzut-o deja, ca să știm dacă îi arătăm badge-ul
  // "Noutăți" sau nu.
  lastSeenChangelogVersion Int @default(0)

  // Pagină publică de catalog (opțională — producătorul o activează explicit)
  publicPageEnabled Boolean  @default(false)
  slug              String?  @unique
  businessName      String?
  bio               String?
  instagramUrl      String?
  bresloUrl         String?
  etsyUrl           String?
  websiteUrl        String?
  facebookUrl       String?
  catalogTemplate   String?  @default("natural")

  // Cont de echipă — un membru invitat de un cont principal ("owner") partajează
  // aceleași date (UserData) și același abonament activ, fără cont de plată propriu.
  teamOwnerId String?
  teamOwner   User?   @relation("TeamMembers", fields: [teamOwnerId], references: [id], onDelete: SetNull)
  teamMembers User[]  @relation("TeamMembers")

  // Administrator platformă — cont separat de conturile clienților, creat automat
  // din ADMIN_EMAIL/ADMIN_PASSWORD (.env), vezi src/seedAdmin.js. Nu depinde de
  // Stripe (are mereu acces la aplicație) și poate vedea panoul /admin.html.
  isAdmin Boolean @default(false)

  // Blocare temporară a contului după prea multe parole greșite consecutive —
  // protecție SUPLIMENTARĂ față de rate-limiting-ul pe IP din routes/auth.js
  // (acela taie un IP; asta protejează un cont anume, indiferent de la câte
  // adrese IP diferite se încearcă). Vezi recordFailedLogin/isAccountLocked
  // din src/auth.js. Se resetează automat la orice login reușit.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Autentificare în doi factori (TOTP — compatibil Google Authenticator,
  // Authy, 1Password etc.). Momentan disponibilă doar pentru conturi cu
  // isAdmin:true (vezi src/routes/twofactor.js) — clienții obișnuiți nu-l văd
  // și nu sunt afectați. twoFactorSecret nu e niciodată trimis către client
  // după activare; twoFactorBackupCodes sunt hash-uite (bcrypt), nu în clar.
  twoFactorEnabled     Boolean @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes Json?   @default("[]")

  data     UserData?
  feedback Feedback[]
}

// Istoric al firmelor (CUI) și, separat, al adreselor de e-mail care au
// avut vreodată un abonament plătit — protecție de rezervă pentru prețul
// introductiv de 99 lei. Motiv: politica de retenție (src/retention.js)
// ȘTERGE DEFINITIV contul (User) la 30 de zile după anulare, dacă nu se
// reabonează — inclusiv User.hasEverSubscribed. Fără aceste tabele separate,
// un fost client al cărui cont a fost șters ar putea recrea un cont nou (cu
// alt CUI, dar același e-mail, sau invers) și ar primi din nou, din
// greșeală, prețul de bun-venit. NU au nicio relație Prisma cu User, deci NU
// sunt afectate de ștergerea contului.
//
// IMPORTANT — retenție proprie, LIMITATĂ (nu "pentru totdeauna"): conform
// principiului limitării stocării (art. 5 alin. (1) lit. e) GDPR) și
// Politicii de confidențialitate (secțiunea 3), aceste rânduri se șterg
// definitiv după INTRO_HISTORY_RETENTION_YEARS ani de la ULTIMA activare
// (vezi src/retention.js — purgeIntroPriceHistory, rulează zilnic).
// lastActivatedAt se actualizează la FIECARE activare (nu doar la prima),
// deci fereastra de protecție se reînnoiește cât timp clientul rămâne activ.
model IntroPriceHistory {
  cui             String   @id
  lastActivatedAt DateTime @default(now())
}

model IntroPriceHistoryEmail {
  email           String   @id
  lastActivatedAt DateTime @default(now())
}

// Feedback trimis din aplicație (buton "Feedback" din topbar) — folosit doar
// intern, ca să dezvoltăm aplicația pe baza a ceea ce chiar contează pentru
// utilizatori. Dacă utilizatorul își șterge contul (manual sau automat, prin
// politica de retenție — vezi src/retention.js), userId devine null și
// email-ul e anonimizat: mesajul rămâne, pentru îmbunătățirea produsului, dar
// fără nicio legătură cu identitatea utilizatorului — vezi Politica de
// confidențialitate, secțiunea 3.
model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  category  String   // "bug" | "idee" | "altceva"
  message   String
  page      String?  // ce tab era deschis când a fost trimis, pentru context
  status    String   @default("nou") // nou | citit | rezolvat
  createdAt DateTime @default(now())
}

// Prospecți de vânzare (leads) — firme/persoane potențial interesate să devină
// clienți Herbatium, NU utilizatori ai aplicației. Complet separat de modelul
// User: nu au cont, nu se pot autentifica, nu ating datele clienților reali.
// Vizibil doar în panoul de admin (isAdmin) — vezi src/routes/leads.js.
model Lead {
  id          String   @id @default(uuid())
  // Unic — necesar pentru upsert atomic la (re)import (vezi upsertLeads în
  // src/routes/leads.js): fără asta, două importuri simultane cu același
  // nume ar putea crea două leaduri duplicate în loc de a-l actualiza pe cel
  // existent (condiție de cursă găsită la audit).
  nume        String   @unique
  ceVinde     String?
  oras        String?
  contact     String?  // email și/sau telefon, format liber (așa cum a fost găsit prin cercetare)
  tipContact  String?  // Email | Telefon | Formular | Social
  sursa       String?  // URL-ul de unde a fost preluat contactul
  verificare  String?  // ex. "Verificat direct", "Din agregator/articol"
  potrivire   String?  // ex. "Bun — producător/formulator propriu", "Slab — ..."
  stare       String   @default("nou") // nou | contactat | interesat | client | refuzat
  notite      String?  // notițe libere ale adminului (ex. cum a decurs discuția)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserData {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipes           Json     @default("[]")
  batches           Json     @default("[]")
  customIngredients Json     @default("[]")
  products          Json     @default("[]")
  ingredientPrices  Json     @default("{}")
  stock             Json     @default("{}")
  costState         Json     @default("{}")
  sales             Json     @default("[]")
  lyeState          Json     @default("{}")
  // Dosare PIF (Product Information File, Art. 11 Reg. 1223/2009), câte unul
  // per produs, cheie = id-ul produsului (din câmpul "products" de mai sus).
  // Structură (client-side, nu impusă de schemă): descriere, fabricatie,
  // dovadaClaims, testareAnimale — texte libere completate de utilizator;
  // evaluareSiguranta — text liber, NU generat de aplicație (vezi comentariul
  // din src/routes/pif-docs.js: concluzia de siguranță cere un evaluator
  // calificat, aplicația doar oferă loc pentru notițe/atașarea raportului
  // extern semnat); documente — listă de fișiere atașate (vezi pif-docs.js).
  pifRecords        Json     @default("{}")

  // Dosare ambalaj (Reg. (UE) 2025/40 — PPWR, aplicabil din 12 august 2026),
  // câte unul per produs, cheie = id-ul produsului (din câmpul "products").
  // Structură (client-side, nu impusă de schemă): material/tip ambalaj,
  // furnizor, stare declarație de conformitate (documente — vezi
  // packaging-docs.js), checklist restricții de substanțe (metale grele
  // ≤100 mg/kg, PFAS) completat manual de utilizator — NU verificat automat
  // de aplicație — și o notă liberă privind reciclabilitatea (Art. 6,
  // obligatoriu abia din 2030, informativă aici).
  packagingRecords  Json     @default("{}")

  updatedAt         DateTime @updatedAt
}
